{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FeaChat",
  "version": "0.2.0",
  "identifier": "com.feachat.desktop",
  "build": {
    "beforeDevCommand": "../scripts/tauri_before_dev.sh",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  }
}
